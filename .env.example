# DB (AWS RDS endpoint)
# 같은 VPC 내부 통신이면 useSSL=false 통상 허용.
# 외부망/보수적 운영이라면 useSSL=true&requireSSL=true 로 두고 RDS CA 번들을 별도 처리.
DB_URL=jdbc:mysql://<your-rds-endpoint>:3306/caffeine_tracker?serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=caffeine
DB_PASSWORD=your-strong-db-password

# JWT (최소 32바이트 이상의 강한 랜덤 문자열)
# 생성: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# Grafana 관리자(admin) 비밀번호 — docker-compose.prod.yml 전용. 없으면 compose 가 기동을 거부한다
# 생성: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password

# 경보(Alertmanager → SNS) — docker-compose.prod.yml 의 alerting 프로필 전용. AWS 준비 전에는 비워 둔다(docs/alerting-plan.md)
# 비어 있으면 Alertmanager 컨테이너만 시작을 거부하고 앱 기동은 막지 않는다. SNS 인증은 EC2 인스턴스 역할이라 키를 넣지 않는다
ALERT_TOPIC_ARN=
HEARTBEAT_TOPIC_ARN=
AWS_REGION=
