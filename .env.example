# DB (AWS RDS endpoint)
# 같은 VPC 내부 통신이면 useSSL=false 통상 허용.
# 외부망/보수적 운영이라면 useSSL=true&requireSSL=true 로 두고 RDS CA 번들을 별도 처리.
DB_URL=jdbc:mysql://<your-rds-endpoint>:3306/caffeine_tracker?serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=caffeine
DB_PASSWORD=your-strong-db-password

# JWT (최소 32바이트 이상의 강한 랜덤 문자열)
# 생성: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here
