    {
      "id": 12,
      "type": "timeseries",
      "title": "학습 실행 결과 (최근 1시간)",
      "description": "POST /api/learning/run 실행 수를 결과별로 센다. LEARNED 는 1밤 이상 학습, 그 외는 응답 skipReason. 0인 결과는 숨긴다. 앱은 실행이 건너뛰어져도 200 을 받으므로 HTTP 패널에는 안 보이는 값이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(caffeine_learning_runs_total{job=\"caffeine-app\"}[1h])) > 0",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
